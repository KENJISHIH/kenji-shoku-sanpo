{
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "kenji-shoku-sanpo.vercel.app" }],
      "destination": "https://food.kenjishih.com.tw/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/photos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
